-- [[ AUTO BLOCK SCRIPT - UPGRADED & CLEANED ]] --
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Variables
local isAutoBlockEnabled = false
local blockDistance = 20
local isBlocking = false

-- Locate Remotes Safely (Increased Timeout for slow loading)
local blockService = ReplicatedStorage:WaitForChild("Knit", 10)
if blockService then
    blockService = blockService:WaitForChild("Knit", 10)
    if blockService then
        blockService = blockService:WaitForChild("Services", 10)
        if blockService then
            blockService = blockService:WaitForChild("BlockService", 10)
            if blockService then
                blockService = blockService:WaitForChild("RE", 10)
            end
        end
    end
end

local activatedRemote = blockService and blockService:FindFirstChild("Activated")
local deactivatedRemote = blockService and blockService:FindFirstChild("Deactivated")

-- [[ UI CONSTRUCTION ]] --
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "AutoBlock_ModernUI"
ScreenGui.ResetOnSpawn = false
if not pcall(function() ScreenGui.Parent = CoreGui end) then
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 200, 0, 150)
MainFrame.Position = UDim2.new(0.5, -100, 0.4, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
MainFrame.BorderSizePixel = 0
MainFrame.Parent = ScreenGui
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 10)
Instance.new("UIStroke", MainFrame).Color = Color3.fromRGB(60, 60, 60)

local TopBar = Instance.new("TextLabel")
TopBar.Size = UDim2.new(1, 0, 0, 30)
TopBar.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
TopBar.Text = "  AUTO BLOCK"
TopBar.TextColor3 = Color3.fromRGB(255, 255, 255)
TopBar.Font = Enum.Font.GothamBold
TopBar.TextSize = 14
TopBar.TextXAlignment = Enum.TextXAlignment.Left
TopBar.Parent = MainFrame
Instance.new("UICorner", TopBar).CornerRadius = UDim.new(0, 10)

-- Fix TopBar bottom corners to blend with MainFrame
local TopBarHider = Instance.new("Frame")
TopBarHider.Size = UDim2.new(1, 0, 0, 10)
TopBarHider.Position = UDim2.new(0, 0, 1, -10)
TopBarHider.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
TopBarHider.BorderSizePixel = 0
TopBarHider.Parent = TopBar

local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Size = UDim2.new(0.85, 0, 0, 30)
ToggleBtn.Position = UDim2.new(0.075, 0, 0.28, 0)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
ToggleBtn.Text = "STATUS: OFF"
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.Font = Enum.Font.GothamBold
ToggleBtn.TextSize = 13
ToggleBtn.Parent = MainFrame
Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(0, 6)

local StatusLabel = Instance.new("TextLabel")
StatusLabel.Size = UDim2.new(1, 0, 0, 20)
StatusLabel.Position = UDim2.new(0, 0, 0.52, 0)
StatusLabel.BackgroundTransparency = 1
StatusLabel.Text = "System: Idle"
StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
StatusLabel.Font = Enum.Font.GothamSemibold
StatusLabel.TextSize = 12
StatusLabel.Parent = MainFrame

local DistanceLabel = Instance.new("TextLabel")
DistanceLabel.Size = UDim2.new(1, 0, 0, 20)
DistanceLabel.Position = UDim2.new(0, 0, 0.68, 0)
DistanceLabel.BackgroundTransparency = 1
DistanceLabel.Text = "Range: " .. blockDistance
DistanceLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
DistanceLabel.Font = Enum.Font.Gotham
DistanceLabel.TextSize = 12
DistanceLabel.Parent = MainFrame

-- Slider
local SliderBg = Instance.new("Frame")
SliderBg.Size = UDim2.new(0.85, 0, 0, 8)
SliderBg.Position = UDim2.new(0.075, 0, 0.85, 0)
SliderBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
SliderBg.Parent = MainFrame
Instance.new("UICorner", SliderBg).CornerRadius = UDim.new(0, 4)

local SliderFill = Instance.new("Frame")
SliderFill.Size = UDim2.new((blockDistance - 3) / 37, 0, 1, 0)
SliderFill.BackgroundColor3 = Color3.fromRGB(80, 150, 255)
SliderFill.Parent = SliderBg
Instance.new("UICorner", SliderFill).CornerRadius = UDim.new(0, 4)

-- [[ UI LOGIC ]] --
ToggleBtn.MouseButton1Click:Connect(function()
    isAutoBlockEnabled = not isAutoBlockEnabled
    if isAutoBlockEnabled then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 80)
        ToggleBtn.Text = "STATUS: ON"
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
        ToggleBtn.Text = "STATUS: OFF"
    end
end)

local isDraggingSlider = false
local function updateSlider(input)
    local percentage = math.clamp((input.Position.X - SliderBg.AbsolutePosition.X) / SliderBg.AbsoluteSize.X, 0, 1)
    SliderFill.Size = UDim2.new(percentage, 0, 1, 0)
    blockDistance = math.floor(3 + 37 * percentage)
    DistanceLabel.Text = "Range: " .. blockDistance
end

SliderBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingSlider = true
        updateSlider(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingSlider = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDraggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateSlider(input)
    end
end)

-- Make GUI Draggable
local draggingUI = false
local dragStart, startPos
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingUI = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if draggingUI and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
TopBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingUI = false
    end
end)

-- [[ SCRIPT LOGIC ]] --
local function getRootPart(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function lookAtTarget(targetPart)
    local char = LocalPlayer.Character
    local myRoot = getRootPart(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if myRoot and targetPart then
        if hum then hum.AutoRotate = false end
        myRoot.CFrame = CFrame.lookAt(myRoot.Position, Vector3.new(targetPart.Position.X, myRoot.Position.Y, targetPart.Position.Z))
        task.delay(0.4, function()
            if hum then hum.AutoRotate = true end
        end)
    end
end

local function triggerBlock()
    if not activatedRemote or not deactivatedRemote then
        StatusLabel.Text = "System: Missing Remote"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        return false
    end

    local success, err = pcall(function() activatedRemote:FireServer() end)
    if success then
        StatusLabel.Text = "System: BLOCKED!"
        StatusLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
        
        task.delay(0.4, function()
            pcall(function() deactivatedRemote:FireServer() end)
            StatusLabel.Text = "System: Idle"
            StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        end)
        return true
    else
        StatusLabel.Text = "System: Error"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        return false
    end
end

local function setupRemoteListener(remote)
    if not remote:IsA("RemoteEvent") then return end
    if remote == activatedRemote or remote == deactivatedRemote then return end
    if remote.Name:lower():find("emote") then return end

    remote.OnClientEvent:Connect(function(...)
        if not isAutoBlockEnabled or isBlocking then return end

        local myRoot = getRootPart(LocalPlayer.Character)
        if not myRoot then return end

        local args = {...}
        local targetRoot = nil

        for _, arg in ipairs(args) do
            if typeof(arg) == "Instance" then
                local model = arg:IsA("Model") and arg or arg:FindFirstAncestorOfClass("Model")
                if model and model ~= LocalPlayer.Character then
                    local root = getRootPart(model)
                    if root and (myRoot.Position - root.Position).Magnitude <= blockDistance then
                        targetRoot = root
                        break
                    end
                end
            end
        end

        if targetRoot then
            isBlocking = true
            lookAtTarget(targetRoot)
            triggerBlock()
            task.delay(0.4, function() isBlocking = false end)
        end
    end)
end

-- Connect to all current and future remotes
for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
    setupRemoteListener(obj)
end
ReplicatedStorage.DescendantAdded:Connect(setupRemoteListener)

if not activatedRemote then
    StatusLabel.Text = "Game Updated: Patch Detected"
    StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    warn("[Auto Block] The game has changed its remote paths. The script may not work.")
end
